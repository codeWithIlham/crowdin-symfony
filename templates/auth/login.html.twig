{% extends 'base.html.twig' %}
{% block title %}Connexion — Crowdin{% endblock %}

{% block stylesheets %}
<style>
    main { padding-top: 0; }
    html, body { overflow: hidden; height: 100%; }
    footer { display: none; }

    .auth-page {
        height: 100vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr auto;
        position: relative;
        z-index: 1;
    }

    @media (max-width: 700px) {
        .auth-page { grid-template-columns: 1fr; height: auto; min-height: 100vh; }
        .auth-left  { display: none; }
        .auth-right { padding: 3rem 1.5rem; }
    }

    /* ── PANNEAU GAUCHE ── */
    .auth-left {
        display: flex; flex-direction: column;
        padding: 3rem 2.5rem;
        background: var(--bg);
        box-shadow: 6px 0 18px var(--sh-dark);
        z-index: 2;
    }

    .left-logo {
        display: flex; align-items: center; gap: 0.7rem; margin-bottom: 2rem;
    }
    .left-logo-mark {
        width: 40px; height: 40px; border-radius: 13px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; font-weight: 900; color: var(--accent-text);
        box-shadow: 5px 5px 10px var(--sh-dark), -5px -5px 10px var(--sh-light);
    }
    .left-logo-name { font-size: 1.1rem; font-weight: 800; color: var(--text); letter-spacing: -0.3px; }

    .left-hero { flex: 1; display: flex; flex-direction: column; justify-content: center; }

    .globe-wrap {
        width: 210px; height: 210px; margin: 0 auto 1.75rem;
        position: relative;
        animation: bookFloat 3.8s ease-in-out infinite;
    }
    .globe-svg { width: 100%; height: 100%; }

    @keyframes bookFloat {
        0%, 100% { transform: translateY(0) rotate(-1.5deg); }
        50%       { transform: translateY(-14px) rotate(1.5deg); }
    }

    .doc-tag {
        position: absolute;
        background: var(--bg);
        box-shadow: 3px 3px 8px var(--sh-dark), -3px -3px 8px var(--sh-light);
        border-radius: 9px;
        padding: 0.35rem 0.65rem;
        font-size: 0.68rem; font-weight: 700; color: var(--text-dim);
        white-space: nowrap;
        animation: floatTag 4s ease-in-out infinite;
    }
    .doc-tag:nth-child(1) { top: 5px;    left: -65px;  animation-delay: 0s; }
    .doc-tag:nth-child(2) { top: 70px;   right: -75px; animation-delay: 1.1s; }
    .doc-tag:nth-child(3) { bottom: 50px; left: -55px; animation-delay: 0.55s; }
    .doc-tag:nth-child(4) { bottom: 10px; right: -50px; animation-delay: 1.7s; }
    @keyframes floatTag {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-7px); }
    }

    .left-tagline { text-align: center; margin-bottom: 1.75rem; }
    .left-tagline h2 {
        font-size: 1.6rem; font-weight: 900; color: var(--text);
        letter-spacing: -0.8px; line-height: 1.2; margin-bottom: 0.45rem;
    }
    .left-tagline h2 span { color: var(--accent-text); }
    .left-tagline p { font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; max-width: 260px; margin: 0 auto; }

    .left-stats {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.65rem;
    }
    .stat-chip {
        text-align: center; padding: 0.8rem 0.5rem; border-radius: 14px;
        box-shadow: 5px 5px 10px var(--sh-dark), -5px -5px 10px var(--sh-light);
    }
    .stat-chip-num { display: block; font-size: 1.25rem; font-weight: 900; color: var(--text); letter-spacing: -0.5px; }
    .stat-chip-lbl { display: block; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted); margin-top: 0.15rem; }

    /* ── PANNEAU DROIT ── */
    .auth-right {
        display: flex; align-items: center; justify-content: center;
        padding: 5rem 2.5rem 2.5rem;
        position: relative; z-index: 1;
        overflow-y: auto;
        min-height: 0;
    }

    .form-card {
        width: 100%; max-width: 360px;
        animation: cardIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes cardIn {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .form-card h1 { font-size: 1.65rem; font-weight: 900; letter-spacing: -0.8px; color: var(--text); margin-bottom: 0.25rem; }
    .form-card-sub { font-size: 0.84rem; color: var(--text-muted); margin-bottom: 1.75rem; }
    .form-card-sub a { color: var(--accent-text); font-weight: 700; text-decoration: none; }
    .form-card-sub a:hover { text-decoration: underline; }

    /* Fields */
    .field-g { margin-bottom: 1rem; }
    .field-lbl { display: block; font-size: 0.67rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.9px; color: var(--text-muted); margin-bottom: 0.4rem; }
    .field-wrap { position: relative; }
    .field-icon { position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); font-size: 0.88rem; color: var(--text-muted); pointer-events: none; opacity: 0.5; }
    .field-inp {
        width: 100%; padding: 0.82rem 1rem 0.82rem 2.5rem;
        background: var(--bg); border: none; border-radius: 13px;
        color: var(--text); font-size: 0.9rem; font-family: inherit; outline: none; transition: all 0.2s;
        box-shadow: inset 3px 3px 6px var(--sh-dark), inset -3px -3px 6px var(--sh-light);
    }
    .field-inp::placeholder { color: var(--text-muted); opacity: 0.55; }
    .field-inp:focus { box-shadow: inset 4px 4px 8px var(--sh-dark), inset -4px -4px 8px var(--sh-light), 0 0 0 2px var(--accent); }
    .field-inp.pr { padding-right: 2.8rem; }
    .eye-btn {
        position: absolute; right: 0.9rem; top: 50%; transform: translateY(-50%);
        background: none; border: none; cursor: pointer; color: var(--text-muted); opacity: 0.5;
        font-size: 0.88rem; padding: 0; line-height: 1; transition: opacity 0.18s;
    }
    .eye-btn:hover { opacity: 0.85; }

    .submit-btn {
        width: 100%; margin-top: 0.5rem; padding: 0.9rem;
        background: var(--bg); border: none; border-radius: 13px;
        color: var(--accent-text); font-size: 0.95rem; font-weight: 800;
        cursor: pointer; font-family: inherit; letter-spacing: 0.1px; transition: all 0.2s;
        box-shadow: 6px 6px 12px var(--sh-dark), -6px -6px 12px var(--sh-light);
    }
    .submit-btn:hover { box-shadow: 8px 8px 16px var(--sh-dark), -8px -8px 16px var(--sh-light); transform: translateY(-1px); }
    .submit-btn:active { box-shadow: inset 3px 3px 6px var(--sh-dark), inset -3px -3px 6px var(--sh-light); transform: none; }

    /* ── FOOTER AUTH ── */
    .auth-footer {
        grid-column: 1 / -1;
        text-align: center;
        padding: 0.7rem 1rem;
        font-size: 0.68rem;
        color: var(--text-muted);
        border-top: 1px solid var(--sh-dark);
        letter-spacing: 0.3px;
    }
    .auth-footer strong { color: var(--accent-text); font-weight: 700; }

    .error-box {
        padding: 0.75rem 1rem; border-radius: 12px; margin-bottom: 1rem;
        font-size: 0.82rem; color: #c0556a;
        box-shadow: inset 3px 3px 6px var(--sh-dark), inset -3px -3px 6px var(--sh-light);
    }

    /* ── SECTION DÉMO ── */
    .demo-toggle {
        width: 100%; margin-top: 1.4rem;
        display: flex; align-items: center; justify-content: space-between;
        padding: 0.75rem 1rem; border-radius: 14px; border: none;
        background: var(--bg); cursor: pointer; font-family: inherit;
        box-shadow: 5px 5px 10px var(--sh-dark), -5px -5px 10px var(--sh-light);
        transition: all 0.2s;
    }
    .demo-toggle:hover { box-shadow: 7px 7px 14px var(--sh-dark), -7px -7px 14px var(--sh-light); }
    .demo-toggle:active { box-shadow: inset 3px 3px 6px var(--sh-dark), inset -3px -3px 6px var(--sh-light); }
    .demo-toggle-left { display: flex; align-items: center; gap: 0.6rem; }
    .demo-toggle-label { font-size: 0.78rem; font-weight: 800; color: var(--text); letter-spacing: -0.1px; }
    .demo-toggle-sub { font-size: 0.62rem; color: var(--text-muted); }
    .demo-burger { display: flex; flex-direction: column; gap: 4px; }
    .demo-burger span {
        display: block; width: 18px; height: 2px; border-radius: 2px;
        background: var(--accent-text); transition: all 0.3s;
        transform-origin: center;
    }
    .demo-toggle.open .demo-burger span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .demo-toggle.open .demo-burger span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .demo-toggle.open .demo-burger span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    .demo-drawer {
        overflow: hidden;
        max-height: 0;
        transition: max-height 0.35s cubic-bezier(0.4,0,0.2,1), opacity 0.3s;
        opacity: 0;
    }
    .demo-drawer.open { max-height: 300px; opacity: 1; }

    .demo-cards {
        display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.55rem;
        padding-top: 0.75rem;
    }

    .demo-card {
        display: flex; flex-direction: column; align-items: center;
        padding: 0.9rem 0.5rem 0.75rem; border-radius: 16px;
        text-decoration: none; text-align: center;
        transition: all 0.2s;
        box-shadow: 5px 5px 10px var(--sh-dark), -5px -5px 10px var(--sh-light);
        position: relative; overflow: hidden;
    }
    .demo-card:hover {
        transform: translateY(-3px);
        box-shadow: 7px 7px 14px var(--sh-dark), -7px -7px 14px var(--sh-light);
    }
    .demo-card:active {
        transform: none;
        box-shadow: inset 3px 3px 6px var(--sh-dark), inset -3px -3px 6px var(--sh-light);
    }

    .dc-badge {
        width: 36px; height: 36px; border-radius: 11px; margin-bottom: 0.55rem;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem;
        box-shadow: inset 2px 2px 5px var(--sh-dark), inset -2px -2px 5px var(--sh-light);
    }
    .dc-badge.admin   { color: #7c6ae8; }
    .dc-badge.manager { color: #14b8a6; }
    .dc-badge.trans   { color: #f59e0b; }
    .dc-badge.both    { color: #3b82f6; }

    .dc-title {
        font-size: 0.74rem; font-weight: 800; color: var(--text);
        letter-spacing: -0.2px; line-height: 1.2; margin-bottom: 0.2rem;
    }
    .dc-desc  { font-size: 0.6rem; color: var(--text-muted); line-height: 1.3; }

    .dc-arrow {
        margin-top: 0.55rem;
        width: 22px; height: 22px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.7rem; font-weight: 700; color: var(--accent-text);
        box-shadow: 2px 2px 4px var(--sh-dark), -2px -2px 4px var(--sh-light);
    }
</style>
{% endblock %}

{% block body %}
<div class="auth-page">

    {# ══ GAUCHE ══ #}
    <div class="auth-left">
        <div class="left-logo">
            <div class="left-logo-mark"><svg width="22" height="18" viewBox="0 0 20 16" fill="none"><path d="M1 4.5h14M11 1.5l4 3-4 3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M19 11.5H5M9 8.5l-4 3 4 3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <span class="left-logo-name">Crowdin</span>
        </div>

        <div class="left-hero">
            <div class="globe-wrap">
                <div class="doc-tag">📖 Chapitre 1</div>
                <div class="doc-tag">🌍 Version FR</div>
                <div class="doc-tag">📝 Traduit ✓</div>
                <div class="doc-tag">⇄ 250+ langues</div>
                <svg class="globe-svg" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <filter id="bsh" x="-20%" y="-20%" width="140%" height="140%">
                            <feDropShadow dx="3" dy="5" stdDeviation="7" flood-color="#b9c0cf" flood-opacity="0.55"/>
                        </filter>
                    </defs>

                    <!-- Ombre portée -->
                    <ellipse cx="100" cy="181" rx="58" ry="6" fill="#b9c0cf" opacity="0.22"/>

                    <!-- Page gauche (texte original) -->
                    <path d="M 18 44 L 96 39 L 96 158 L 18 163 Z" fill="#eceef4" filter="url(#bsh)"/>

                    <!-- Page droite (texte traduit) -->
                    <path d="M 104 39 L 182 44 L 182 163 L 104 158 Z" fill="#e7eaf0" filter="url(#bsh)"/>

                    <!-- Reliure -->
                    <rect x="94" y="37" width="12" height="123" rx="3" fill="#9196a8"/>
                    <rect x="94" y="37" width="4" height="123" rx="2" fill="rgba(255,255,255,0.2)"/>

                    <!-- Arche du haut (courbure des pages) -->
                    <path d="M 96 39 Q 100 33 104 39" stroke="#9196a8" stroke-width="2" fill="none" stroke-linecap="round"/>

                    <!-- Lignes page gauche — texte original (gris) -->
                    <rect x="30" y="62" width="52" height="4.5" rx="2.25" fill="#cdd1dc"/>
                    <rect x="30" y="74" width="44" height="4" rx="2" fill="#d2d6e1"/>
                    <rect x="30" y="85" width="50" height="4" rx="2" fill="#d2d6e1"/>
                    <rect x="30" y="96" width="37" height="4" rx="2" fill="#d2d6e1"/>
                    <rect x="30" y="107" width="54" height="4" rx="2" fill="#d2d6e1"/>
                    <rect x="30" y="118" width="42" height="4" rx="2" fill="#d2d6e1"/>
                    <rect x="30" y="129" width="48" height="4" rx="2" fill="#d2d6e1"/>
                    <rect x="30" y="140" width="35" height="3.5" rx="1.75" fill="#d8dce5"/>

                    <!-- Lignes page droite — traduction (violet accent) -->
                    <rect x="118" y="62" width="52" height="4.5" rx="2.25" fill="#b5aff0"/>
                    <rect x="118" y="74" width="44" height="4" rx="2" fill="#bdb9f2"/>
                    <rect x="118" y="85" width="50" height="4" rx="2" fill="#bdb9f2"/>
                    <rect x="118" y="96" width="37" height="4" rx="2" fill="#bdb9f2"/>
                    <rect x="118" y="107" width="54" height="4" rx="2" fill="#bdb9f2"/>
                    <rect x="118" y="118" width="42" height="4" rx="2" fill="#bdb9f2"/>
                    <rect x="118" y="129" width="48" height="4" rx="2" fill="#bdb9f2"/>
                    <rect x="118" y="140" width="35" height="3.5" rx="1.75" fill="#c5c2f4"/>

                    <!-- Marque-page -->
                    <rect x="160" y="37" width="10" height="34" rx="3" fill="#7c6ae8"/>
                    <polygon points="160,71 170,71 165,80" fill="#7c6ae8"/>

                    <!-- Numéros de page -->
                    <text x="57"  y="157" text-anchor="middle" font-size="7" fill="#c0c4ce" font-family="-apple-system,sans-serif" font-weight="600">42</text>
                    <text x="143" y="157" text-anchor="middle" font-size="7" fill="#c0c4ce" font-family="-apple-system,sans-serif" font-weight="600">43</text>
                </svg>
            </div>

            <div class="left-tagline">
                <h2>Bridging Languages,<br><span>Connecting Teams</span></h2>
                <p>Gérez vos projets de traduction, assignez vos traducteurs et suivez la progression en temps réel.</p>
            </div>

            <div class="left-stats">
                <div class="stat-chip">
                    <span class="stat-chip-num">35+</span>
                    <span class="stat-chip-lbl">🌍 Langues</span>
                </div>
                <div class="stat-chip">
                    <span class="stat-chip-num">1.2k</span>
                    <span class="stat-chip-lbl">📄 Projets</span>
                </div>
                <div class="stat-chip">
                    <span class="stat-chip-num">250+</span>
                    <span class="stat-chip-lbl">👥 Équipes</span>
                </div>
            </div>
        </div>
    </div>

    {# ══ DROITE ══ #}
    <div class="auth-right">
        <div class="form-card">

            {% if app.flashes('info')|length > 0 %}
                {% for msg in app.flashes('info') %}
                    <div style="padding:0.9rem 1.1rem;border-radius:13px;margin-bottom:1.25rem;font-size:0.85rem;font-weight:700;color:#2f7d58;background:rgba(47,158,110,0.08);border-left:3px solid #2f9e6e;box-shadow:4px 4px 10px var(--sh-dark),-4px -4px 10px var(--sh-light);">
                        ✅ {{ msg }}
                    </div>
                {% endfor %}
            {% endif %}

            <h1>Bon retour !</h1>
            <p class="form-card-sub">Pas de compte ? <a href="{{ path('app_register') }}">S'inscrire →</a></p>

            {% if error %}
                <div class="error-box">⚠ {{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post">
                <div class="field-g">
                    <label class="field-lbl" for="username">Email</label>
                    <div class="field-wrap">
                        <span class="field-icon">✉</span>
                        <input class="field-inp" type="text" id="username" name="_username"
                               value="{{ last_username }}" autocomplete="username"
                               placeholder="vous@example.com" required>
                    </div>
                </div>
                <div class="field-g">
                    <label class="field-lbl" for="password">Mot de passe</label>
                    <div class="field-wrap">
                        <span class="field-icon">🔒</span>
                        <input class="field-inp pr" type="password" id="password" name="_password"
                               autocomplete="current-password" placeholder="••••••••" required>
                        <button type="button" class="eye-btn" onclick="togglePwd(this)">🙈</button>
                    </div>
                </div>
                <button type="submit" class="submit-btn">Se connecter →</button>
            </form>

            {# ── DÉMO ── #}
            <button type="button" class="demo-toggle" id="demoToggle" onclick="toggleDemo(this)">
                <div class="demo-toggle-left">
                    <div>
                        <div class="demo-toggle-label">Accès démo instantané</div>
                        <div class="demo-toggle-sub">Choisissez un rôle pour explorer</div>
                    </div>
                </div>
                <div class="demo-burger">
                    <span></span><span></span><span></span>
                </div>
            </button>
            <div class="demo-drawer" id="demoDrawer">
                <div class="demo-cards">
                    <a href="{{ path('app_demo', {role: 'admin'}) }}" class="demo-card">
                        <div class="dc-badge admin">★</div>
                        <div class="dc-title">Admin</div>
                        <div class="dc-desc">Accès complet, tous les projets</div>
                        <div class="dc-arrow">→</div>
                    </a>
                    <a href="{{ path('app_demo', {role: 'manager'}) }}" class="demo-card">
                        <div class="dc-badge manager">⚙</div>
                        <div class="dc-title">Chef de projet</div>
                        <div class="dc-desc">Créer, importer, réviser</div>
                        <div class="dc-arrow">→</div>
                    </a>
                    <a href="{{ path('app_demo', {role: 'translator'}) }}" class="demo-card">
                        <div class="dc-badge trans">✎</div>
                        <div class="dc-title">Traducteur</div>
                        <div class="dc-desc">Traduire les chaînes</div>
                        <div class="dc-arrow">→</div>
                    </a>
                    <a href="{{ path('app_demo', {role: 'both'}) }}" class="demo-card">
                        <div class="dc-badge both">⇄</div>
                        <div class="dc-title">Les deux</div>
                        <div class="dc-desc">Gérer & traduire des projets</div>
                        <div class="dc-arrow">→</div>
                    </a>
                </div>
            </div>

        </div>
    </div>

    <div class="auth-footer">
        &copy; 2026 Crowdin &mdash; <strong>Ilham &middot; Paulin &middot; Dan</strong>
    </div>

</div>

<script>
function togglePwd(btn) {
    const inp = btn.previousElementSibling;
    inp.type = inp.type === 'password' ? 'text' : 'password';
    btn.textContent = inp.type === 'password' ? '🙈' : '🙉';
}
function toggleDemo(btn) {
    btn.classList.toggle('open');
    document.getElementById('demoDrawer').classList.toggle('open');
}
</script>
{% endblock %}
