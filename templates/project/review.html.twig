{% extends 'base_app.html.twig' %}
{% block title %}Révision — {{ project.name }}{% endblock %}
{% block page_title %}Tableau de révision{% endblock %}
{% block nav_projects %}active{% endblock %}

{% block topbar_actions %}
    <a href="{{ path('app_project_show', {id: project.id}) }}" class="btn btn-outline">← Projet</a>
{% endblock %}

{% block stylesheets %}
<style>
    .review-header { margin-bottom: 2rem; }
    .review-header h1 { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.6px; }
    .review-header p { color: var(--text-muted); font-size: 0.88rem; margin-top: 0.3rem; }

    .kanban { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.25rem; align-items: start; }
    @media (max-width: 900px) { .kanban { grid-template-columns: 1fr; } }

    .kanban-col { border-radius: 18px; background: var(--bg); overflow: hidden; box-shadow: 6px 6px 12px var(--sh-dark), -6px -6px 12px var(--sh-light); }

    .kanban-col-header {
        padding: 1rem 1.1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .kanban-col-title { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.5px; display: flex; align-items: center; gap: 0.5rem; }

    .kanban-col-count { font-size: 0.7rem; font-weight: 700; padding: 0.2rem 0.55rem; border-radius: 99px; box-shadow: inset 2px 2px 4px var(--sh-dark), inset -2px -2px 4px var(--sh-light); }

    .kanban-cards { padding: 0.75rem; display: flex; flex-direction: column; gap: 0.75rem; }

    .review-card {
        padding: 1rem;
        border-radius: 14px;
        background: var(--bg);
        transition: box-shadow 0.18s;
        box-shadow: 4px 4px 8px var(--sh-dark), -4px -4px 8px var(--sh-light);
    }

    .review-card:hover { box-shadow: 5px 5px 10px var(--sh-dark), -5px -5px 10px var(--sh-light); }

    .card-lang {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        color: var(--role-text);
        margin-bottom: 0.6rem;
        display: inline-block;
        box-shadow: inset 2px 2px 4px var(--sh-dark), inset -2px -2px 4px var(--sh-light);
    }

    .card-key { font-size: 0.7rem; font-family: monospace; color: var(--text-muted); margin-bottom: 0.3rem; }

    .card-source { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.6rem; line-height: 1.5; border-left: 2px solid var(--sh-dark); padding-left: 0.6rem; }

    .card-translation { font-size: 0.88rem; font-weight: 500; margin-bottom: 0.75rem; line-height: 1.5; }

    .card-meta { font-size: 0.7rem; color: var(--text-muted); margin-bottom: 0.75rem; }

    .card-actions { display: flex; gap: 0.4rem; }

    .btn-approve {
        flex: 1;
        padding: 0.5rem;
        border: none;
        color: #2f9e6e;
        border-radius: 10px;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.18s;
        box-shadow: 3px 3px 6px var(--sh-dark), -3px -3px 6px var(--sh-light);
    }

    .btn-approve:active { box-shadow: inset 2px 2px 4px var(--sh-dark), inset -2px -2px 4px var(--sh-light); }

    .btn-reject-toggle {
        flex: 1;
        padding: 0.5rem;
        border: none;
        color: #c0556a;
        border-radius: 10px;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.18s;
        box-shadow: 3px 3px 6px var(--sh-dark), -3px -3px 6px var(--sh-light);
    }

    .reject-form { margin-top: 0.6rem; display: none; }
    .reject-form.open { display: block; }

    .reject-input {
        width: 100%;
        padding: 0.55rem 0.8rem;
        background: var(--bg);
        border: none;
        border-radius: 10px;
        color: var(--text);
        font-size: 0.82rem;
        font-family: inherit;
        outline: none;
        margin-bottom: 0.5rem;
        resize: none;
        box-shadow: inset 3px 3px 6px var(--sh-dark), inset -3px -3px 6px var(--sh-light);
    }

    .reject-submit {
        width: 100%;
        padding: 0.5rem;
        color: #c0556a;
        border: none;
        border-radius: 10px;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.18s;
        box-shadow: 3px 3px 6px var(--sh-dark), -3px -3px 6px var(--sh-light);
    }

    .comment-badge {
        font-size: 0.75rem;
        color: #c0556a;
        border-radius: 10px;
        padding: 0.5rem 0.65rem;
        margin-top: 0.3rem;
        line-height: 1.5;
        box-shadow: inset 2px 2px 4px var(--sh-dark), inset -2px -2px 4px var(--sh-light);
    }

    .empty-col { text-align: center; padding: 2rem 1rem; color: var(--text-muted); font-size: 0.82rem; }
</style>
{% endblock %}

{% block body %}
<div class="fade-up">

    {% for msg in app.flashes('success') %}
        <div class="flash-success">✓ {{ msg }}</div>
    {% endfor %}

    <div class="review-header">
        <h1>Révision — <span class="grad">{{ project.name }}</span></h1>
        <p>{{ submitted|length }} traduction(s) en attente · {{ approved|length }} approuvée(s) · {{ rejected|length }} rejetée(s)</p>
    </div>

    <div class="kanban">

        {# ── COLONNE EN ATTENTE ── #}
        <div class="kanban-col">
            <div class="kanban-col-header">
                <div class="kanban-col-title">
                    <span style="color:#f59e0b;">●</span> En attente de révision
                </div>
                <span class="kanban-col-count" style="color:#c97a2e;">{{ submitted|length }}</span>
            </div>
            <div class="kanban-cards">
                {% if submitted is empty %}
                    <div class="empty-col">Aucune traduction en attente</div>
                {% endif %}
                {% for t in submitted %}
                <div class="review-card">
                    <div>
                        <span class="card-lang">{{ t.language.code }}</span>
                    </div>
                    <div class="card-key">{{ t.sourceKey }}</div>
                    <div class="card-source">{{ t.sourceText }}</div>
                    <div class="card-translation">{{ t.translatedText }}</div>
                    <div class="card-meta">
                        Par {{ t.translator ? t.translator.email|split('@')|first : '?' }}
                    </div>
                    <div class="card-actions">
                        <form method="POST" action="{{ path('app_translation_approve', {id: project.id, translationId: t.id}) }}" style="flex:1;display:flex;">
                            <button type="submit" class="btn-approve" style="width:100%;">✓ Approuver</button>
                        </form>
                        <button type="button" class="btn-reject-toggle" onclick="toggleReject({{ t.id }})">✗ Rejeter</button>
                    </div>
                    <div class="reject-form" id="reject-{{ t.id }}">
                        <form method="POST" action="{{ path('app_translation_reject', {id: project.id, translationId: t.id}) }}">
                            <textarea class="reject-input" name="comment" rows="2" placeholder="Raison du rejet (optionnel)..."></textarea>
                            <button type="submit" class="reject-submit">Confirmer le rejet</button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        {# ── COLONNE APPROUVÉ ── #}
        <div class="kanban-col">
            <div class="kanban-col-header">
                <div class="kanban-col-title">
                    <span style="color:#10b981;">●</span> Approuvées
                </div>
                <span class="kanban-col-count" style="color:#2f9e6e;">{{ approved|length }}</span>
            </div>
            <div class="kanban-cards">
                {% if approved is empty %}
                    <div class="empty-col">Aucune traduction approuvée</div>
                {% endif %}
                {% for t in approved %}
                <div class="review-card">
                    <div><span class="card-lang">{{ t.language.code }}</span></div>
                    <div class="card-key">{{ t.sourceKey }}</div>
                    <div class="card-source">{{ t.sourceText }}</div>
                    <div class="card-translation" style="color:#2f9e6e;">{{ t.translatedText }}</div>
                    <div class="card-meta">Par {{ t.translator ? t.translator.email|split('@')|first : '?' }}</div>
                </div>
                {% endfor %}
            </div>
        </div>

        {# ── COLONNE REJETÉ ── #}
        <div class="kanban-col">
            <div class="kanban-col-header">
                <div class="kanban-col-title">
                    <span style="color:#ef4444;">●</span> Rejetées
                </div>
                <span class="kanban-col-count" style="color:#c0556a;">{{ rejected|length }}</span>
            </div>
            <div class="kanban-cards">
                {% if rejected is empty %}
                    <div class="empty-col">Aucune traduction rejetée</div>
                {% endif %}
                {% for t in rejected %}
                <div class="review-card">
                    <div><span class="card-lang">{{ t.language.code }}</span></div>
                    <div class="card-key">{{ t.sourceKey }}</div>
                    <div class="card-source">{{ t.sourceText }}</div>
                    <div class="card-translation" style="color:#c0556a;">{{ t.translatedText }}</div>
                    {% if t.reviewComment %}
                        <div class="comment-badge">💬 {{ t.reviewComment }}</div>
                    {% endif %}
                    <div class="card-meta" style="margin-top:0.5rem;">Par {{ t.translator ? t.translator.email|split('@')|first : '?' }}</div>
                </div>
                {% endfor %}
            </div>
        </div>

    </div>
</div>

<script>
function toggleReject(id) {
    const el = document.getElementById('reject-' + id);
    el.classList.toggle('open');
}
</script>
{% endblock %}
