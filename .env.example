# Copier ce fichier en .env puis adapter les valeurs (ne jamais publier le vrai .env).
APP_ENV=dev
# Générer une valeur aléatoire : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=remplacez-moi

# Base MySQL lancée par docker compose
MYSQL_ROOT_PASSWORD=root-a-changer
MYSQL_DATABASE=crowdin
MYSQL_USER=crowdin
MYSQL_PASSWORD=mot-de-passe-a-changer
DATABASE_URL="mysql://crowdin:mot-de-passe-a-changer@127.0.0.1:3306/crowdin?serverVersion=8.0&charset=utf8mb4"

# Emails de développement (Mailpit : http://localhost:8025)
MAILER_DSN=smtp://localhost:1025
MAILER_FROM=noreply@crowdin.local
